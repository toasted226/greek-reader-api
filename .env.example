# Copy this file to .env next to compose.yaml and fill in the values.
# .env is git-ignored and is the single source of deployment configuration.

# Compose
COMPOSE_PROJECT_NAME=greek-reader

# ASP.NET environment. compose.local.yaml overrides this with Development.
ASPNETCORE_ENVIRONMENT=Production

# Serve Swagger UI and the OpenAPI document. Set to false to disable them.
OPENAPI_ENABLED=true

# Public URLs for your deployment
API_BASE_URL=https://api.example.com
FRONTEND_BASE_URL=https://app.example.com

# Host ports. Bind to loopback and let a reverse proxy forward traffic.
# Check for conflicts first: ss -ltnp | grep -E ':5080|:4000'
API_BIND=127.0.0.1
API_PORT=5080
WEB_BIND=127.0.0.1
WEB_PORT=4000

# Database. Generate the password with: openssl rand -hex 32
# Avoid ; = quotes and newlines so it remains a valid connection-string value.
DB_HOST=db
DB_PORT=5432
DB_NAME=greekreader
DB_USER=greekreader
POSTGRES_PASSWORD=replace-with-openssl-rand-hex-32

# SMTP. Username/password may be empty for relays that do not require auth.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USE_SSL=true
SMTP_FROM=no-reply@example.com
SMTP_FROM_NAME=Greek Reader
SMTP_USERNAME=
SMTP_PASSWORD=

# Data Protection key ring inside the container
DATA_PROTECTION_KEYS_PATH=/var/lib/greekreader/dataprotection-keys

# Repository locations, relative to compose.yaml (backend/api).
# Defaults match the recommended self-hosted layout:
ENGINE_CONTEXT=../engine
FRONTEND_CONTEXT=../../frontend/web
# Adjust these paths if your checkouts live elsewhere.
