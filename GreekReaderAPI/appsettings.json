{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=master;Username=postgres;Password=postgres"
  },
  "Email": {
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": 587,
    "UseSsl": true,
    "FromName": "Greek Reader"
  },
  "App": {
    "BackendBaseUrl": "http://localhost:3000",
    "FrontendBaseUrl": "http://localhost:4200"
  },
  "Analyse": {
    "MaxTextLength": 50000
  },
  "Lexicon": {
    "FormMaxLength": 100,
    "DefaultPageSize": 50,
    "MaxPageSize": 200
  },
  "OpenApi": {
    "Enabled": true
  },
  "DataProtection": {
    "KeysPath": ""
  },
  "FileUpload": {
    "MaxFileBytes": 1048576,
    "MaxFilesPerUser": 100,
    "MaxTextBytesPerUser": 52428800,
    "AllowedExtensions": [ ".txt", ".text" ],
    "AllowedContentTypes": [ "text/plain" ]
  }
}
